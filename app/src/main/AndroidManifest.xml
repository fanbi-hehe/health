<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 网络权限 —— AI 识别与对话 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 定位权限 —— GPS 运动记录 -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- 身体活动识别 —— 系统步数 -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <!-- 相机权限 —— 饮食拍照 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- 震动权限 —— 训练休息倒计时 -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 通知权限 (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 前台服务 —— 倒计时通知常驻 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- 前台服务类型 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:name=".HealthApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Health"
        tools:targetApi="35">
        <!-- FileProvider —— 相机拍照 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- 组间休息倒计时前台服务（specialUse：训练休息计时） -->
        <service
            android:name=".worker.RestTimerService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="training_rest_timer" />
        </service>

        <!-- GPS 运动记录前台服务 -->
        <service
            android:name=".worker.GpsTrackService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- 桌面小组件：今日热量进度 -->
        <receiver
            android:name=".widget.CalorieWidgetReceiver"
            android:exported="true"
            android:label="@string/calorie_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/calorie_widget_info" />
        </receiver>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Health"
            android:windowSoftInputMode="adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
